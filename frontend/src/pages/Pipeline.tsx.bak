import React, { useState, useEffect } from "react";

const API_BASE = "http://localhost:8800/api/pipeline";

interface Novel {
  name: string;
  path: string;
  size: number;
}

export default function Pipeline() {
  const [novels, setNovels] = useState<Novel[]>([]);
  const [selectedNovel, setSelectedNovel] = useState("");
  const [jobId, setJobId] = useState<string | null>(null);
  const [status, setStatus] = useState<string>("");
  const [message, setMessage] = useState<string>("");
  const [loading, setLoading] = useState(false);
  const [uploadedFile, setUploadedFile] = useState<File | null>(null);

  useEffect(() => {
    fetchNovels();
  }, []);

  useEffect(() => {
    if (jobId && status === "running" || status === "pending") {
      const timer = setInterval(() => checkStatus(jobId), 2000);
      return () => clearInterval(timer);
    }
  }, [jobId, status]);

  const fetchNovels = async () => {
    try {
      const res = await fetch(`${API_BASE}/novels`);
      const data = await res.json();
      setNovels(data.novels || []);
    } catch (e) {
      console.error("Failed to fetch novels", e);
    }
  };

  const startPipeline = async () => {
    setLoading(true);
    setMessage("");
    try {
      const res = await fetch(`${API_BASE}/run`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ novel_path: selectedNovel }),
      });
      const data = await res.json();
      setJobId(data.job_id);
      setStatus(data.status);
      setMessage("Pipeline started...");
    } catch (e: any) {
      setMessage(`Error: ${e.message}`);
    }
    setLoading(false);
  };

  const handleUpload = async () => {
    if (!uploadedFile) return;
    setLoading(true);
    setMessage("");
    try {
      const formData = new FormData();
      formData.append("file", uploadedFile);
      const res = await fetch(`${API_BASE}/upload`, {
        method: "POST",
        body: formData,
      });
      const data = await res.json();
      setJobId(data.job_id);
      setStatus(data.status);
      setMessage("Uploaded! Pipeline started...");
    } catch (e: any) {
      setMessage(`Error: ${e.message}`);
    }
    setLoading(false);
  };

  const checkStatus = async (id: string) => {
    try {
      const res = await fetch(`${API_BASE}/status/${id}`);
      const data = await res.json();
      setStatus(data.status);
      setMessage(data.message);
    } catch (e) {
      console.error("Status check failed", e);
    }
  };

  const getStatusEmoji = (s: string) => {
    switch (s) {
      case "completed": return "✅";
      case "failed": return "❌";
      case "running": return "🔄";
      case "pending": return "⏳";
      case "cancelled": return "⛔";
      default: return "❓";
    }
  };

  return (
    <div style={{ maxWidth: 800, margin: "0 auto", padding: 40 }}>
      <h1 style={{ fontSize: 28, marginBottom: 8 }}>
        🎬 小说 → AI漫剧
      </h1>
      <p style={{ color: "#666", marginBottom: 32 }}>
        一键将小说转换为AI漫剧/视频
      </p>

      {/* Upload Section */}
      <div style={{
        border: "2px dashed #d9d9d9",
        borderRadius: 12,
        padding: 32,
        textAlign: "center",
        marginBottom: 24,
        background: "#fafafa",
      }}>
        <p style={{ fontSize: 16, marginBottom: 16, color: "#888" }}>
          拖拽或点击上传小说 .txt 文件
        </p>
        <input
          type="file"
          accept=".txt"
          onChange={(e) => setUploadedFile(e.target.files?.[0] || null)}
          style={{ marginBottom: 12 }}
        />
        {uploadedFile && (
          <div>
            <p style={{ color: "#333" }}>{uploadedFile.name}</p>
            <button
              onClick={handleUpload}
              disabled={loading}
              style={{
                padding: "10px 32px",
                fontSize: 16,
                background: "#1677ff",
                color: "white",
                border: "none",
                borderRadius: 8,
                cursor: loading ? "not-allowed" : "pointer",
                opacity: loading ? 0.6 : 1,
              }}
            >
              {loading ? "处理中..." : "🚀 一键生成"}
            </button>
          </div>
        )}
      </div>

      {/* Or Select Existing */}
      <div style={{ marginBottom: 24 }}>
        <h3 style={{ marginBottom: 12 }}>或选择已有小说:</h3>
        <select
          value={selectedNovel}
          onChange={(e) => setSelectedNovel(e.target.value)}
          style={{
            width: "100%",
            padding: "10px 16px",
            fontSize: 16,
            borderRadius: 8,
            border: "1px solid #d9d9d9",
            marginBottom: 12,
          }}
        >
          <option value="">-- 选择小说 --</option>
          {novels.map((n) => (
            <option key={n.path} value={n.path}>
              {n.name} ({Math.round(n.size / 1024)} KB)
            </option>
          ))}
        </select>

        {selectedNovel && (
          <button
            onClick={startPipeline}
            disabled={loading}
            style={{
              padding: "10px 32px",
              fontSize: 16,
              background: "#52c41a",
              color: "white",
              border: "none",
              borderRadius: 8,
              cursor: loading ? "not-allowed" : "pointer",
              opacity: loading ? 0.6 : 1,
            }}
          >
            {loading ? "处理中..." : "🚀 开始生成"}
          </button>
        )}
      </div>

      {/* Status */}
      {jobId && (
        <div style={{
          background: "#f6ffed",
          border: "1px solid #b7eb8f",
          borderRadius: 12,
          padding: 24,
        }}>
          <h3>
            {getStatusEmoji(status)} Job: {jobId}
          </h3>
          <p style={{ fontSize: 16, color: "#333" }}>
            Status: <strong>{status}</strong>
          </p>
          {message && (
            <p style={{ color: "#666", marginTop: 8 }}>{message}</p>
          )}
          {status === "running" && (
            <div style={{
              marginTop: 16,
              height: 6,
              background: "#e8e8e8",
              borderRadius: 3,
            }}>
              <div style={{
                height: "100%",
                width: "60%",
                background: "linear-gradient(90deg, #1677ff, #52c41a)",
                borderRadius: 3,
                animation: "pulse 2s infinite",
              }} />
            </div>
          )}
        </div>
      )}

      {/* No backend warning */}
      {!jobId && novels.length === 0 && (
        <div style={{
          background: "#fff7e6",
          border: "1px solid #ffd591",
          borderRadius: 12,
          padding: 24,
          marginTop: 24,
        }}>
          <p>
            ⚠️ 后端服务未连接。请确保已启动后端服务:
            <br />
            <code style={{ background: "#f0f0f0", padding: "4px 8px", borderRadius: 4 }}>
              python run.py --web
            </code>
          </p>
        </div>
      )}
    </div>
  );
}
