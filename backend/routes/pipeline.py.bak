"""
Pipeline trigger route - enables web-based novel-to-video pipeline execution.

Endpoints:
    POST /api/pipeline/run         Start pipeline for a novel
    POST /api/pipeline/upload      Upload novel and run pipeline
    GET  /api/pipeline/status/{id} Check pipeline job status
    GET  /api/pipeline/novels      List available novels
"""
from __future__ import annotations

import json
import os
import subprocess
import sys
import threading
import uuid
from datetime import datetime
from pathlib import Path
from typing import Any, Dict, Optional

from fastapi import APIRouter, HTTPException, UploadFile, File, Form
from loguru import logger
from pydantic import BaseModel, Field

router = APIRouter(prefix="/api/pipeline", tags=["Pipeline"])

PROJECT_ROOT = Path(__file__).parent.parent.parent
NOVELS_DIR = PROJECT_ROOT / "novels"
OUTPUT_DIR = PROJECT_ROOT / "output"
NOVELS_DIR.mkdir(parents=True, exist_ok=True)
OUTPUT_DIR.mkdir(parents=True, exist_ok=True)

# Job storage (in production, use DB/Redis)
_jobs: Dict[str, Dict[str, Any]] = {}


class PipelineRunRequest(BaseModel):
    novel_path: str = Field(..., description="Path to novel .txt file")
    style: Optional[str] = Field(None, description="Art style")
    chapter: Optional[int] = Field(None, description="Specific chapter to process")
    tts_enabled: bool = Field(True, description="Enable TTS voiceover")
    subtitles_enabled: bool = Field(True, description="Enable subtitles")
    bgm_enabled: bool = Field(False, description="Enable background music")


class PipelineStatusResponse(BaseModel):
    job_id: str
    novel: str
    status: str
    progress: float = 0.0
    message: str = ""
    started_at: Optional[str] = None
    finished_at: Optional[str] = None
    output_dir: Optional[str] = None


class NovelListResponse(BaseModel):
    novels: list
    total: int


def _run_pipeline_thread(job_id: str, novel_path: str, style: Optional[str] = None):
    """Run pipeline in background thread."""
    try:
        _jobs[job_id]["status"] = "running"
        _jobs[job_id]["message"] = "Pipeline starting..."

        pipeline_script = PROJECT_ROOT / "pipeline.py"
        if not pipeline_script.exists():
            _jobs[job_id]["status"] = "failed"
            _jobs[job_id]["message"] = "pipeline.py not found"
            return

        cmd = [sys.executable, str(pipeline_script), str(novel_path)]
        if style:
            cmd.extend(["--style", style])

        logger.info(f"[Pipeline] Starting: {' '.join(cmd)}")

        process = subprocess.Popen(
            cmd,
            cwd=str(PROJECT_ROOT),
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            encoding="utf-8",
            errors="replace",
        )

        output_lines = []
        for line in process.stdout:
            output_lines.append(line)
            # Update progress based on pipeline output
            _jobs[job_id]["output"] = "".join(output_lines[-100:])

            if "Phase" in line or "stage" in line.lower():
                _jobs[job_id]["message"] = line.strip()

        process.wait()

        if process.returncode == 0:
            _jobs[job_id]["status"] = "completed"
            _jobs[job_id]["progress"] = 1.0
            _jobs[job_id]["message"] = "Pipeline completed successfully"
        else:
            _jobs[job_id]["status"] = "failed"
            _jobs[job_id]["message"] = f"Pipeline failed with code {process.returncode}"

        _jobs[job_id]["finished_at"] = datetime.now().isoformat()

    except Exception as e:
        _jobs[job_id]["status"] = "failed"
        _jobs[job_id]["message"] = str(e)
        _jobs[job_id]["finished_at"] = datetime.now().isoformat()
        logger.error(f"[Pipeline] Job {job_id} failed: {e}")


@router.post("/run")
async def run_pipeline(request: PipelineRunRequest):
    """Start a novel-to-video pipeline job."""
    novel_path = Path(request.novel_path)
    if not novel_path.exists():
        raise HTTPException(status_code=404, detail=f"Novel not found: {request.novel_path}")

    job_id = str(uuid.uuid4())[:8]
    now = datetime.now().isoformat()

    _jobs[job_id] = {
        "job_id": job_id,
        "novel": novel_path.name,
        "status": "pending",
        "progress": 0.0,
        "message": "Queued",
        "started_at": now,
        "finished_at": None,
        "output_dir": str(OUTPUT_DIR / novel_path.stem),
    }

    # Run in background
    thread = threading.Thread(
        target=_run_pipeline_thread,
        args=(job_id, str(novel_path), request.style),
        daemon=True,
    )
    thread.start()

    logger.info(f"[Pipeline] Job {job_id} started for {novel_path.name}")
    return {"job_id": job_id, "status": "pending", "novel": novel_path.name}


@router.post("/upload")
async def upload_and_run(
    file: UploadFile = File(...),
    style: str = Form(None),
):
    """Upload a novel file and start the pipeline."""
    if not file.filename.endswith(".txt"):
        raise HTTPException(status_code=400, detail="Only .txt files accepted")

    # Save uploaded file
    content = await file.read()
    novel_path = NOVELS_DIR / file.filename
    novel_path.write_bytes(content)

    job_id = str(uuid.uuid4())[:8]
    now = datetime.now().isoformat()

    _jobs[job_id] = {
        "job_id": job_id,
        "novel": file.filename,
        "status": "pending",
        "progress": 0.0,
        "message": "Queued",
        "started_at": now,
        "finished_at": None,
        "output_dir": str(OUTPUT_DIR / file.filename.replace(".txt", "")),
    }

    thread = threading.Thread(
        target=_run_pipeline_thread,
        args=(job_id, str(novel_path), style),
        daemon=True,
    )
    thread.start()

    logger.info(f"[Pipeline] Upload + start: {file.filename} -> job {job_id}")
    return {"job_id": job_id, "status": "pending", "novel": file.filename}


@router.get("/status/{job_id}")
async def get_status(job_id: str):
    """Get pipeline job status."""
    if job_id not in _jobs:
        raise HTTPException(status_code=404, detail="Job not found")

    job = _jobs[job_id]
    return {
        **job,
        "output": job.get("output", "")[-2000:] if "output" in job else "",
    }


@router.get("/novels")
async def list_novels():
    """List available novels."""
    novels = []

    if NOVELS_DIR.exists():
        for f in sorted(NOVELS_DIR.glob("*.txt")):
            novels.append({
                "name": f.name,
                "path": str(f),
                "size": f.stat().st_size,
                "modified": datetime.fromtimestamp(f.stat().st_mtime).isoformat(),
            })

    for f in sorted(PROJECT_ROOT.glob("novel*.txt")):
        novels.append({
            "name": f.name,
            "path": str(f),
            "size": f.stat().st_size,
            "modified": datetime.fromtimestamp(f.stat().st_mtime).isoformat(),
        })

    return {"total": len(novels), "novels": novels}


@router.delete("/jobs/{job_id}")
async def cancel_job(job_id: str):
    """Cancel a running pipeline job."""
    if job_id not in _jobs:
        raise HTTPException(status_code=404, detail="Job not found")
    if _jobs[job_id]["status"] in ("running", "pending"):
        _jobs[job_id]["status"] = "cancelled"
        _jobs[job_id]["message"] = "Cancelled by user"
    return {"status": "cancelled"}
